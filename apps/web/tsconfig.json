{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@freescale/ui/*": ["../../packages/ui/src/*"],
      "@freescale/db/*": ["../../packages/db/src/*"],
      "@freescale/ai/*": ["../../packages/ai/src/*"],
      "@freescale/types/*": ["../../packages/types/src/*"]
    },
    "allowJs": true,
    "noEmit": true
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
