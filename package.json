{
  "name": "freescale",
  "version": "0.1.0",
  "private": true,
  "description": "Unified multi-channel inbox with AI copilot Mue",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "format": "biome format --write .",
    "format:check": "biome format ."
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "turbo": "^2.3.0",
    "typescript": "^5.6.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
